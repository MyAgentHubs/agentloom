    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
