{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    "jsx": "react-jsx",
    "types": ["vite/client"],

    "paths": {
      "@app/*": ["../app/src/*"],
      "@tauri-apps/api": ["./src/stubs/tauri-runtime-stub.ts"],
      "@tauri-apps/api/*": ["./src/stubs/tauri-runtime-stub.ts"],
      "@tauri-apps/plugin-dialog": ["./src/stubs/tauri-runtime-stub.ts"],
      "@tauri-apps/plugin-dialog/*": ["./src/stubs/tauri-runtime-stub.ts"],
      "@tauri-apps/plugin-opener": ["./src/stubs/tauri-runtime-stub.ts"],
      "@tauri-apps/plugin-opener/*": ["./src/stubs/tauri-runtime-stub.ts"],
      "@tauri-apps/plugin-clipboard-manager": ["./src/stubs/tauri-runtime-stub.ts"],
      "@tauri-apps/plugin-clipboard-manager/*": ["./src/stubs/tauri-runtime-stub.ts"]
    },

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
